# ---- API -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000

# ---- SQL Server --------------------------------------------------------------
# Works with the docker-compose service, a local install, Azure SQL or SQL Server Express.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=Fathom
DB_USER=sa
DB_PASSWORD=Fathom!Dev2026
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10

# Optional least-privilege login for the assistant's report queries.
# `npm run db:migrate` creates it (requires DB_USER to be sysadmin/sa) and
# maps it to the reporting_reader role, which can only SELECT reporting.* views.
DB_REPORTING_USER=fathom_reporting
DB_REPORTING_PASSWORD=Reporting!Dev2026

# ---- Auth --------------------------------------------------------------------
# At least 32 characters. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# ---- AI ----------------------------------------------------------------------
# Any OpenAI-compatible chat-completions API (OpenAI, Azure via proxy, Groq, OpenRouter, Ollama...).
# Leave AI_API_KEY empty to run fully offline with the built-in, data-grounded engine.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000

# ---- Demo data ---------------------------------------------------------------
# Password for every seeded demo account (admin@fathom.dev, manager@fathom.dev, member@fathom.dev, ...).
SEED_DEMO_PASSWORD=Password123!
# Set to "false" to skip automatic migrate/seed when the API starts.
AUTO_MIGRATE=true
AUTO_SEED=true

# ---- Web (Vite) --------------------------------------------------------------
# Leave empty to use the Vite dev-server proxy (/api -> http://localhost:4000).
VITE_API_URL=
